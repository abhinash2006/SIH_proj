# ==============================================================================
# Git Ignore for Drone VGGT & SIH Disaster Inspection System
# ==============================================================================

# Python Environments & Caches
drone_vggt_env/
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.log

# Frontend & Node Dependencies / Build Artefacts
node_modules/
frontend/node_modules/
frontend/.vite/
frontend/dist/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Deep Learning Models & Heavy Weights (>100MB / binary checkpoints)
# (Models should be downloaded using scripts/download_models.py)
models/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx

# Raw Drone Videos & Heavy Media Files
data/raw/
data/frames/
data/refined_frames/
data/selected_frames/
data/uav_sequence/
data/uav_finetune/
data/uav_finetune_test/
data/uploads/
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Output Artifacts & 3D Reconstructions
output/
outputs/
*.ply
*.ply.gz
*.splat
*.obj
*.glb
*.gltf
*.las
*.laz

# SQLite Databases & Session State
*.sqlite3
*.db
*.db-journal

# Scratch & Temporary Run Dirs
scratch/flooded_frames/
scratch/sample_frames/
scratch/*.ply
tmp/
temp/

# OS & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Large Archive Files
*.tar.gz
*.7z
*.rar
*.zip
!vggt_uav_custom_files.zip
